            <component
              refId="Package\SalesReturnTable Aptos\pulling from Aptos"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="pulling from Aptos"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @StartDate datetime =convert(date, getdate()-30,10),
		@EndDate datetime =convert(date, getdate()-1,10)


Select transaction_date,
       location_code,
	   other_location,
	   transaction_no,
	   register_no,
	   document_number,
	   transaction_type_code,
	   QtySold * (-1) as QtySold ,
	   Productcosts * (-1) as Productcosts,
	   NetSales *(-1) as NetSales,
	   sku_id,
	   style_code,
	   case when transaction_type_code in (600,605) then 'S' else 'R' end as SaleType,
	   [transaction_reason_desc]
from
(
(
Select transaction_date,
       location_code,
	   other_location, 
	   transaction_no,
	   register_no,
	   document_number,
	   transaction_type_code,
	   QtySold,
	   ProductCosts,
	   NetSales,
	   sku_id,
	   style_code,
	   'N/A' as transaction_reason_desc
from  
(Select transaction_date,
       l.location_code,
	   ll.location_code as other_location,
	   transaction_no, 
       register_no,
	   document_number,
	   transaction_type_code, 
	  ---- batch_no,
	   SUM(transaction_units) as QtySold,
	   SUM(transaction_cost)  as ProductCosts, 
	   SUM(transaction_valuation_retail) as NetSales,
	   sku.sku_id,
	   s.style_code 
from 
[me_wsl_01].dbo.ib_inventory ib with (nolock)
left join
[me_wsl_01].dbo.location l with (nolock)
on
ib.location_id =l.location_id
left join
[me_wsl_01].dbo.location ll with (nolock)
on
ib.other_location_id =ll.location_id 
left join
[me_wsl_01].dbo.sku sku with (nolock)
on
ib.sku_id=sku.sku_id
left join
[me_wsl_01].dbo.style s with (nolock)
on 
sku.style_id=s.style_id
where ib.transaction_type_code in (600) and (ib.transaction_date between @StartDate and @EndDate) 
group by transaction_date, l.location_code,ll.location_code,transaction_no,register_no,transaction_type_code, sku.sku_id,s.style_code,document_number---,batch_no 
)a
where QtySold &lt;&gt; 0
)
UNION ALL
(
Select transaction_date,
       location_code,
	   other_location, 
	   transaction_no,
	   register_no,
	   document_number,
	   transaction_type_code,
	   QtySold,
	   ProductCosts,
	   NetSales,
	   sku_id,
	   style_code,
	   isNULL(transaction_reason_desc, 'N/A') as transaction_reason_desc 
from 
(
Select transaction_date,
       l.location_code,
	   ll.location_code as other_location,
	   transaction_no, 
       register_no,
	   document_number,
	   transaction_type_code, 
	   SUM(transaction_units) as QtySold,
	   SUM(transaction_cost)  as ProductCosts, 
	   SUM(transaction_valuation_retail) as NetSales,
	   sku.sku_id,
	   s.style_code,
	   r.transaction_reason_desc
from [me_wsl_01].dbo.ib_inventory ib with (nolock)
left join
[me_wsl_01].dbo.location l with (nolock)
on
ib.location_id =l.location_id
left join
[me_wsl_01].dbo.location ll with (nolock)
on 
ib.other_location_id  =ll.location_id 
left join
[me_wsl_01].dbo.sku sku with (nolock)
on
ib.sku_id=sku.sku_id
left join
[me_wsl_01].dbo.style s with (nolock)
on
sku.style_id=s.style_id
left join
[me_wsl_01].[dbo].[transaction_reason_data] r
on
ib.transaction_reason_id=r.transaction_reason_id
where ib.transaction_type_code in (610) and (ib.transaction_date between @StartDate and @EndDate) 
group by transaction_date, l.location_code,ll.location_code, transaction_no,register_no,transaction_type_code, sku.sku_id,s.style_code,document_number,transaction_reason_desc
)a
where QtySold &lt;&gt; 0
)
UNION ALL
(Select transaction_date,
       location_code,
	   other_location, 
	   transaction_no,
	   register_no,
	   document_number,
	   transaction_type_code,
	   QtySold,
	   ProductCosts,
	   NetSales,
	   sku_id,
	   style_code,
	   'N/A' as transaction_reason_desc 
from
(
Select transaction_date,
       l.location_code,
	   ll.location_code as other_location,
	   transaction_no, 
       register_no,
	   document_number,
	   transaction_type_code, 
	   SUM(transaction_units) as QtySold,
	   SUM(transaction_cost)  as ProductCosts, 
	   SUM(transaction_valuation_retail) as NetSales,
	   sku.sku_id,
	   s.style_code
from [me_wsl_01].dbo.ib_inventory ib with (nolock)
left join
[me_wsl_01].dbo.location l with (nolock)
on
ib.location_id =l.location_id
left join
[me_wsl_01].dbo.location ll with (nolock)
on
ib.other_location_id =ll.location_id
left join
[me_wsl_01].dbo.sku sku with (nolock)
on
ib.sku_id=sku.sku_id
left join
[me_wsl_01].dbo.style s with (nolock)
on
sku.style_id =s.style_id
where ib.transaction_type_code in (605) and (ib.transaction_date between @StartDate and @EndDate)
group by transaction_date, l.location_code,ll.location_code,transaction_no,register_no,transaction_type_code, sku.sku_id,s.style_code,document_number----,batch_no 
)a
where QtySold &lt;&gt; 0
)
UNION ALL
(Select transaction_date,
       location_code,
	   other_location, 
