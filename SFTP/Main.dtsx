            <component
              refId="Package\ItemMasterAptos\Pull from Aptos"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="Pull from Aptos"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT [SKU]
	  ,[Color]
	  ,[Size]
	  ,[Style]
	  ,[Style_Desc]
	  ,[UPC]
	  ,[Division]
	  ,[Department]
	  ,[Brand]
	  ,[SubDepartment]
	  ,[Class] 
	  ,[ShortBrand] 
	  FROM 
	
	   (SELECT S.sku_id [SKU]
			  ,C.color_long_description [Color]
			  ,SM.size_code [Size]
			  ,ST.style_code [Style]
			  ,ST.long_desc [Style_Desc]
			  ,U.upc_number [UPC]
			  ,ST.style_id
		FROM [me_wsl_01].[dbo].[sku] S WITH (NOLOCK)
		LEFT JOIN [me_wsl_01].[dbo].[style_color] SC WITH (NOLOCK)
		ON S.style_color_id = SC.style_color_id
		LEFT JOIN [me_wsl_01].[dbo].[style_size] SS WITH (NOLOCK)
		ON S.style_size_id = SS.style_size_id
		LEFT JOIN [me_wsl_01].[dbo].[style] ST WITH (NOLOCK)
		ON S.style_id = ST.style_id
		LEFT JOIN [me_wsl_01].[dbo].[color] C WITH (NOLOCK)
		ON SC.color_id = C.color_id
		LEFT JOIN [me_wsl_01].[dbo].[size_master] SM WITH (NOLOCK)
		ON SS.size_master_id = SM.size_master_id
		LEFT JOIN 
		[me_wsl_01].[dbo].[upc] U WITH (NOLOCK)
		--(SELECT [sku_id], MAX([upc_number]) [upc_number]
		-- FROM [EPICORSQL].[me_wsl_01].[dbo].[upc] WITH (NOLOCK)
		-- GROUP BY [sku_id]) U
		ON S.sku_id = U.sku_id) ISC -- Item Specific Characteristics
		LEFT JOIN
		(SELECT DISTINCT div.hierarchy_group_label [Division]
		 ,dept.hierarchy_group_label [Department]
		 ,brand.hierarchy_group_label [Brand]
		 ,subd.hierarchy_group_label [SubDepartment]
		 ,hg.hierarchy_group_label [Class]
		 ,s.style_id
		FROM [me_wsl_01].[dbo].[style] s WITH (NOLOCK)
		INNER JOIN [me_wsl_01].[dbo].[style_group] sg WITH (NOLOCK) 
		ON sg.style_id = s.style_id
		INNER JOIN [me_wsl_01].[dbo].[hierarchy_group] hg WITH (NOLOCK) 
		ON hg.hierarchy_group_id = sg.hierarchy_group_id
		INNER JOIN [me_wsl_01].[dbo].[hierarchy_group] subd WITH (NOLOCK) 
		ON subd.hierarchy_group_id = hg.parent_group_id
		AND subd.hierarchy_level_id = 10000005
		INNER JOIN [me_wsl_01].[dbo].[hierarchy_group] brand WITH (NOLOCK) 
		ON brand.hierarchy_group_id = subd.parent_group_id
		AND brand.hierarchy_level_id = 10000004
		INNER JOIN [me_wsl_01].[dbo].[hierarchy_group] dept WITH (NOLOCK) 
		ON dept.hierarchy_group_id = brand.parent_group_id
		AND dept.hierarchy_level_id = 10000003
		INNER JOIN [me_wsl_01].[dbo].[hierarchy_group] div WITH (NOLOCK) 
		ON div.hierarchy_group_id = dept.parent_group_id
		AND div.hierarchy_level_id = 10000002) VSC -- Vendor Specific Characteristics
		ON ISC.style_id = VSC.style_id
		Left JOIN
		(select s.style_id,ast.attribute_set_label as ShortBrand
		from  me_wsl_01.dbo.entity_attribute_set eas
                             inner join  me_wsl_01.dbo.attribute a on a.attribute_id = eas.attribute_id
                             inner join  me_wsl_01.dbo.attribute_set ast on ast.attribute_set_id = eas.attribute_set_id and a.attribute_id = eas.attribute_id and a.attribute_id = ast.attribute_id
                             inner join  me_wsl_01.dbo.style s on s.style_id = eas.parent_id 
		where eas.parent_type=1 and attribute_code = 'BRAND'
		)SB  ----TopullShortbrandName
		on
		ISC.style_id=SB.style_id;</property>
