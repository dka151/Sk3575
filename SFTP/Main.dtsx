              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="Pullig from Aptos"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @StartDate datetime =CONVERT(Date,GETDATE()-30,10),
		@EndDate datetime =CONVERT(Date,GETDATE()-1,10) 


Select [Date], 
       [StoreID],
	   TransactionID,
	   TenderType,
	   TenderAmt,
	   IsNULL(DocumentNo,'N/A') as DocumentNo,
	   [PaymentTypeDetail]
from
(Select 
       convert(datetime,FulfillDate) as [Date],
       convert(varchar(10),[StoreID]) [StoreID],
	   convert(varchar(15),TransactionID) as TransactionID,
	   Convert(varchar(30),TenderType) as TenderType,
	   convert(varchar(15),[PaymentTypeDetail]) as [PaymentTypeDetail],
	   convert(decimal(18,2),TenderAmt) TenderAmt,
	   convert(nvarchar(100),DocumentNo) as DocumentNo
from
(
Select transaction_date as FulfillDate,
       RIGHT('0000' +  CAST([Store_no] AS VARCHAR),4) [StoreID],
	   transaction_id as TransactionID,
	   TenderType,
	   [PaymentTypeDetail],
	   SUM(gross_line_amount) as TenderAmt,
	   reference_no as DocumentNo
from
(
Select transaction_date,
       [Store_no],
	   transaction_id,
	   case when TenderType ='Debit' and [swipe_indicator] ='206' then 'Debit Tap'
	        when TenderType='Credit Card' and [swipe_indicator] ='206' then 'Credit Card Tap'
			else TenderType end as TenderType,
	   [PaymentTypeDetail],
	   gross_line_amount,
	   reference_no
from
( 
Select store_no,
       register_no,
	   transaction_date,
	   transaction_id,
	   reference_no,
	   [line_object_description],
	   case when [PaymentTypeDetail]='Debit card' then 'Debit'
	        when [PaymentTypeDetail] in ('Visa','MasterCard','American Express','Discover','JCB','Diners Club / EnRoute','PayPal') then 'Credit Card'
			else [PaymentTypeDetail] end as TenderType,
     [PaymentTypeDetail],
      gross_line_amount,
	 [swipe_indicator]
from
(
Select store_no,
	   register_no,
	   transaction_date,
	   transaction_id,
	   reference_no,
	   [line_object_description],
	   case  when  [line_object_description] in ('Check','Mail check') then 'Check'
			 when [line_object_description] in ('Gift card','Gift certificate','Merchandise card') then 'Gift Card'
			 when [line_object_description] in  ('Single-use coupon usage indicator','Promotional reward coupon') then 'Coupon'
			 else [line_object_description] end as [PaymentTypeDetail],
	   case when db_cr_none ='-1' then (-gross_line_amount) else gross_line_amount end as gross_line_amount,
	   [swipe_indicator]
from
(Select th.store_no,
	   th.register_no,
	   th.transaction_date,
	   th.transaction_id,
	   tl.reference_no,
	   tl.line_object,
	   l.[line_object_description],
	   tl.gross_line_amount,
	   tl.db_cr_none,
	   au.[swipe_indicator] 
from  [aw_wsl_01].[dbo].transaction_line tl with (nolock)
JOIN  [aw_wsl_01].[dbo].transaction_header th with (nolock)
ON th.transaction_id = tl.transaction_id
LEFT JOIN [aw_wsl_01].[dbo].[authorization_detail] au with (nolock)
ON tl.transaction_id=au.transaction_id
AND
tl.line_id=au.line_id
JOIN  [aw_wsl_01].[dbo].line_object l with (nolock)
ON tl.line_object=l.line_object 
where tl.line_object in ('602','603','604','606','607','608','609','610','615','617','618','625','628','629','643','9007')
	 and tl.line_void_flag = 0
	 and th.transaction_void_flag=0
     and th.sa_rejection_flag =0
	 and (th.transaction_date between @StartDate and @EndDate) 
	 and th.transaction_category = 201 
UNION ALL
Select th.store_no,
	   th.register_no,
	   th.transaction_date,
	   th.av_transaction_id,
	   tl.reference_no,
	   tl.line_object,
	   l.[line_object_description],
	   tl.gross_line_amount,
	   tl.db_cr_none,
	   au.[swipe_indicator]
 from [aw_wsl_01].[dbo].av_transaction_line tl with (nolock)
JOIN  [aw_wsl_01].[dbo].av_transaction_header th with (nolock)
ON th.av_transaction_id = tl.av_transaction_id
LEFT JOIN [aw_wsl_01].[dbo].[av_authorization_detail] au with (nolock)
ON tl.av_transaction_id=au.av_transaction_id
AND
tl.line_id=au.line_id
JOIN  [aw_wsl_01].[dbo].line_object l with (nolock)
ON tl.line_object=l.line_object 
where tl.line_object in ('602','603','604','606','607','608','609','610','615','617','618','625','628','629','643','9007')
	 and tl.line_void_flag = 0
	 and th.transaction_void_flag=0
     and th.sa_rejection_flag =0
     and (th.transaction_date between @StartDate and @EndDate) 
	and th.transaction_category = 201 
)a
)b
)c
)d group by store_no,transaction_date,transaction_id,reference_no,TenderType,[PaymentTypeDetail]
)e
)f
order by [Date];</property>
