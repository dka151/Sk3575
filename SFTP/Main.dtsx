	   SUM(transaction_valuation_retail) as NetSales,
	   sku.sku_id,
	   s.style_code,
	   r.transaction_reason_desc
from [me_wsl_01].dbo.ib_inventory ib with (nolock)
left join
[me_wsl_01].dbo.location l with (nolock)
on
ib.location_id =l.location_id
left join
[me_wsl_01].dbo.location ll with (nolock)
on
ib.other_location_id =ll.location_id
left join
[me_wsl_01].dbo.sku sku with (nolock)
on
ib.sku_id=sku.sku_id
left join
