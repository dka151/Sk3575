            <component
              refId="Package\DiscountDetailAptos\Pull from Aptos"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="Pull from Aptos"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @StartDate datetime =CONVERT(Date,GETDATE()-30,10), 
		@EndDate datetime =CONVERT(Date,GETDATE()-1,10); 

Select [transaction_id]
       ,[line_id]
       ,[applied_by_line_id]
       ,[pos_discount_level]
       ,[pos_discount_type]
       ,[pos_discount_amount]
       ,[applied_flag]
       ,[pos_discount_serial_no]
       ,[transaction_date]
       ,[sku_id]
       ,[line_object]
	   ,reference_no
	   ,store_no
	   ,register_no
	   ,Case when line_action in (1,90,142) then 'S' 
	        when line_action in (2,99) then 'R' end as SalesType
---[discount_details_test] 
from
(
  SELECT dd.[transaction_id]
       ,dd.[line_id]
       ,dd.[applied_by_line_id]
       ,dd.[pos_discount_level]
       ,dd.[pos_discount_type]
       ,dd.[pos_discount_amount]
       ,dd.[applied_flag]
       ,dd.[pos_discount_serial_no]
       ,th.[transaction_date]
       ,md.[sku_id]
       ,tl.[line_object]
	   ,tl.reference_no
	   ,th.store_no
	   ,th.register_no
	   ,tl.line_action
  FROM [aw_wsl_01].[dbo].[discount_detail]  dd
  INNER JOIN [aw_wsl_01].[dbo].[merchandise_detail] md WITH (NOLOCK) ON dd.[transaction_id] = md.[transaction_id] AND dd.[line_id] = md.[line_id]
  INNER JOIN [aw_wsl_01].[dbo].[transaction_line] tl WITH (NOLOCK) ON dd.[transaction_id] = tl.[transaction_id] AND dd.[line_id] = tl.[line_id]
  INNER JOIN [aw_wsl_01].[dbo].[transaction_header] th WITH (NOLOCK) ON dd.[transaction_id] = th.[transaction_id]
  where th.transaction_date between @StartDate and @EndDate 
  UNION ALL
  SELECT ad.[av_transaction_id] 
       ,ad.[line_id]
       ,ad.[applied_by_line_id]
       ,ad.[pos_discount_level]
       ,ad.[pos_discount_type]
       ,ad.[pos_discount_amount]
       ,ad.[applied_flag]
       ,ad.[pos_discount_serial_no]
       ,ad.[transaction_date]
       ,md.[sku_id]
       ,tl.[line_object]
	   ,tl.reference_no
	   ,th.store_no
	   ,th.register_no
	   ,tl.line_action
  FROM [aw_wsl_01].[dbo].[av_discount_detail] ad
  INNER JOIN [aw_wsl_01].[dbo].[av_merchandise_detail] md WITH (NOLOCK) ON ad.[av_transaction_id] = md.[av_transaction_id] AND ad.[line_id] = md.[line_id]
  INNER JOIN [aw_wsl_01].[dbo].[av_transaction_line] tl WITH (NOLOCK) ON ad.[av_transaction_id] = tl.[av_transaction_id] AND ad.[line_id] = tl.[line_id]
  INNER JOIN [aw_wsl_01].[dbo].[av_transaction_header] th WITH (NOLOCK) ON ad.[av_transaction_id] = th.[av_transaction_id]
  WHERE ad.[transaction_date] BETWEEN  @StartDate AND @EndDate
  
  )a;</property>
