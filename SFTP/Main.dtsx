where ib.transaction_type_code in (615) and (ib.transaction_date between @StartDate and @EndDate)
group by transaction_date, l.location_code,ll.location_code,transaction_no,register_no,transaction_type_code, sku.sku_id,s.style_code,document_number,r.transaction_reason_desc
)a
where QtySold &lt;&gt; 0
)
)a</property>
